generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
}

enum CustomerLevel {
  VIP
  NORMAL
}

enum FollowStatus {
  UNCONTACTED
  FOLLOWING
  CONVERTED
  LOST
}

enum PayStatus {
  PENDING
  PAID
  REFUNDED
}

enum ModuleType {
  category
  group
  feature
}

model Company {
  id                Int     @id @default(autoincrement())
  name              String
  adminFlag         Int     @default(0)
  sourceConfig      String  @default("marketine")
  systemName        String  @default("智能商业营销系统")
  systemDesc        String  @default("智能商业营销系统")
  logoUrlFull       String?
  logoUrlLess       String?
  companyType       Int     @default(1)
  userCompanyStatus Int     @default(1)
  users             User[]
  brands            Brand[]
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(SALES)
  nickname     String?
  avatar       String?
  adminFlag    Int      @default(0)
  cktFlag      Int      @default(0)
  companyId    Int      @default(1)
  actions      String[] @default([])
  moduleIds    Int[]    @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  customers      Customer[]
  orders         Order[]
  brandMembers   BrandMember[]
  ownedProjects   Project[]     @relation("ProjectOwner")
  createdProjects Project[]     @relation("ProjectCreator")
  kolOwned       KolCreator[]   @relation("KolOwner")
  kolCreated     KolCreator[]   @relation("KolCreator")
  kolReviews     KolReview[]    @relation("KolReviewOperator")
  kolLogs        KolLog[]       @relation("KolLogOperator")
  koxTasksCreated KoxTask[]     @relation("KoxTaskCreator")
  campaignProjects KoxCampaignProject[] @relation("CampaignProjectCreator")
  createdById     Int?
  createdBy       User?         @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers    User[]        @relation("UserCreator")

  @@index([role])
  @@index([companyId])
}

model Brand {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  logo        String?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members BrandMember[]

  @@index([companyId])
}

model BrandMember {
  id        Int      @id @default(autoincrement())
  brandId   Int
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleKey   String
  createdAt DateTime @default(now())

  @@unique([brandId, userId, roleKey])
  @@index([userId])
}

model ModuleNode {
  id       Int         @id @default(autoincrement())
  parentId Int?
  parent   ModuleNode? @relation("ModuleTree", fields: [parentId], references: [id])
  children ModuleNode[] @relation("ModuleTree")
  key      String      @unique
  name     String
  icon     String?
  type     ModuleType
  path     String?
  sort     Int         @default(0)
  visible  Boolean     @default(true)

  @@index([parentId])
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  company      String?
  level        CustomerLevel @default(NORMAL)
  followStatus FollowStatus  @default(UNCONTACTED)
  remark       String?       @db.Text
  createdById  Int
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders Order[]

  @@index([phone])
  @@index([level, followStatus])
  @@index([createdById])
  @@index([createdAt])
}

model Order {
  id          Int       @id @default(autoincrement())
  orderNo     String    @unique
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  amount      Decimal   @db.Decimal(12, 2)
  payStatus   PayStatus @default(PENDING)
  orderedAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([payStatus])
  @@index([orderedAt])
}

model ProjectFolder {
  id        Int            @id @default(autoincrement())
  parentId  Int?
  parent    ProjectFolder? @relation("FolderTree", fields: [parentId], references: [id])
  children  ProjectFolder[] @relation("FolderTree")
  brandId   Int            @default(1)
  name      String
  sort      Int            @default(0)
  status    Int            @default(1)
  projects  Project[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([brandId])
  @@index([parentId])
}

model Project {
  id                Int            @id @default(autoincrement())
  projectCode       String         @unique
  name              String
  clientName        String?
  description       String?        @db.Text
  folderId          Int?
  folder            ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  brandId           Int            @default(1)
  productId         Int?
  budgetTotal       Decimal        @default(0) @db.Decimal(14, 2)
  serviceFeeEnabled Boolean        @default(false)
  serviceFeeRate    Decimal        @default(0) @db.Decimal(5, 2)
  taxFeeEnabled     Boolean        @default(false)
  taxFeeRate        Decimal        @default(0) @db.Decimal(5, 2)
  status            String         @default("draft")
  phase             String         @default("planning")
  startDate         DateTime?
  endDate           DateTime?
  ownerId           Int
  owner             User           @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdById       Int
  createdBy         User           @relation("ProjectCreator", fields: [createdById], references: [id])
  version           Int            @default(1)
  archivedAt        DateTime?
  stats             ProjectStats?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([folderId])
  @@index([brandId])
  @@index([status])
  @@index([ownerId])
}

model ProjectStats {
  projectId Int @id
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deliverableCount  Int @default(0)
  plannedQuantity   Int @default(0)
  completedQuantity Int @default(0)
  plannedCost       Decimal @default(0) @db.Decimal(14, 2)
  actualCost        Decimal @default(0) @db.Decimal(14, 2)
  acceptedCount     Int @default(0)
  riskCount         Int @default(0)
  relationCount     Int @default(0)

  quoteDraftAmount         Decimal @default(0) @db.Decimal(14, 2)
  quoteCollaborationStatus String @default("not_configured")
  costCompletedCount       Int @default(0)
  costExpectedCount        Int @default(0)

  sheetCount       Int @default(0)
  talentTotal      Int @default(0)
  formalCount      Int @default(0)
  backupCount      Int @default(0)
  approvedCount    Int @default(0)
  pendingCount     Int @default(0)
  rejectedCount    Int @default(0)
  unavailableCount Int @default(0)

  executionTotal   Int @default(0)
  readyToStart     Int @default(0)
  draftCount       Int @default(0)
  revisionRequired Int @default(0)
  internalReview   Int @default(0)
  brandReview      Int @default(0)
  readyToPublish   Int @default(0)
  publishedCount   Int @default(0)
  overdueCount     Int @default(0)
  attentionLabel   String @default("暂无待办")
  attentionCreator String?
  attentionLevel   String @default("none")
}

model KolCreator {
  id                Int      @id @default(autoincrement())
  authorId          String   @unique
  platform          String   @default("xhs")
  platformId        Int      @default(1)
  nickname          String
  avatar            String?
  cover             String?
  gender            String?
  location          String?
  fans              Int      @default(0)
  mcn               String?
  noteSign          String?
  category          String?
  persona           String?
  tags              String[] @default([])
  recentBrands      String[] @default([])
  noteCount         Int      @default(0)
  exposureMedian    Int      @default(0)
  readMedian        Int      @default(0)
  interactionMedian Int      @default(0)
  engagementRate    Decimal  @default(0) @db.Decimal(5, 2)
  picturePrice      Decimal? @db.Decimal(10, 2)
  videoPrice        Decimal? @db.Decimal(10, 2)
  pictureState      String?
  videoState        String?
  cooperationForm   String?
  homePage          String?

  inLibrary       Boolean  @default(false)
  contactStatus   String   @default("pending")
  contactPhone    String?
  contactWechat   String?
  contactMail     String?
  remark          String?  @db.Text
  resourceStatus  Int      @default(1)
  ownerId         Int?
  owner           User?    @relation("KolOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById     Int
  createdBy       User     @relation("KolCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews KolReview[]

  @@index([inLibrary])
  @@index([mcn])
  @@index([fans])
  @@index([ownerId])
  @@index([contactStatus])
}

model KolReview {
  id           Int       @id @default(autoincrement())
  creatorId    Int
  creator      KolCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status       String    @default("pending")
  summary      String
  changes      Json?
  operatorId   Int
  operator     User      @relation("KolReviewOperator", fields: [operatorId], references: [id])
  reviewedAt   DateTime?
  reviewedById Int?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([creatorId])
}

model KolLog {
  id          Int      @id @default(autoincrement())
  actionType  String
  operatorId  Int
  operator    User     @relation("KolLogOperator", fields: [operatorId], references: [id])
  targetName  String
  targetCount Int      @default(1)
  summary     String
  operatedAt  DateTime @default(now())

  @@index([actionType])
  @@index([operatedAt])
}

model Product {
  id          Int       @id @default(autoincrement())
  parentId    Int?
  parent      Product?  @relation("ProductTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Product[] @relation("ProductTree")
  name        String
  displayName String?
  configType  String    @default("product")
  description String?   @db.Text
  knowledge   String?   @db.Text
  salesPolicy String?   @db.Text
  faq         String?   @db.Text
  coverUrl    String?
  brandId     Int       @default(1)
  sort        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages    ContentPackage[]
  batchTasks  BatchTask[]

  @@index([parentId])
  @@index([brandId])
}

model ContentPackage {
  id           Int       @id @default(autoincrement())
  name         String
  workflowType String    @default("pro")
  productId    Int?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  brandId      Int       @default(1)
  reviewMode   Int       @default(1)
  status       String    @default("active")
  createdById  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  materials PackageMaterial[]

  @@index([productId])
  @@index([brandId])
  @@index([status])
}

model PackageMaterial {
  id             Int       @id @default(autoincrement())
  packageId      Int
  package        ContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title          String
  content        String    @db.Text
  tags           String[]  @default([])
  contentForm    String    @default("image_text")
  images         String[]  @default([])
  status         String    @default("draft")
  conversationId String?
  reviewComment  String?
  reviewedById   Int?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([packageId])
  @@index([status])
}

model BatchTask {
  id          Int       @id @default(autoincrement())
  taskName    String
  status      String    @default("pending")
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  targetQty   Int       @default(1)
  successCount Int      @default(0)
  failedCount Int       @default(0)
  model       String    @default("random")
  packageId   Int?
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([productId])
}

model KosAccount {
  id             Int      @id @default(autoincrement())
  authorId       String   @unique
  nickname       String
  avatar         String?
  platform       String   @default("xhs")
  accountType    String   @default("KOS")
  fans           Int      @default(0)
  regionName     String?
  saleArea       String?
  areaName       String?
  storeName      String?
  accountTag     String?
  operatorName   String?
  operatorMobile String?
  authorUrl      String?
  status         String   @default("enabled")
  brandId        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taskRecords    KoxTaskAuthor[]
  dailyStats     KoxAccountDailyStat[]
  notes          KoxNote[]

  @@index([platform])
  @@index([accountType])
  @@index([brandId])
  @@index([regionName])
  @@index([saleArea])
  @@index([storeName])
}

model KoxNote {
  id           Int         @id @default(autoincrement())
  noteId       String      @unique
  accountId    Int?
  account      KosAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  brandId      Int         @default(1)
  title        String
  content      String?
  coverUrl     String?
  noteUrl      String?
  noteType     String      @default("normal")
  publishTime  DateTime?
  exposure     Int         @default(0)
  views        Int         @default(0)
  likes        Int         @default(0)
  collects     Int         @default(0)
  comments     Int         @default(0)
  shares       Int         @default(0)
  followCount  Int         @default(0)
  pmInquiries  Int         @default(0)
  pmOpenings   Int         @default(0)
  pmLeads      Int         @default(0)
  formLeads    Int         @default(0)
  authorName   String?
  accountType  String?
  isRtbAdver   Boolean?
  brandUserName String?
  category     String?
  modelTag     String?
  keyword      String?
  statDate     DateTime?
  rawJson      Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([brandId, publishTime])
  @@index([accountId])
  @@index([noteType])
}

model KoxAccountDailyStat {
  id             Int      @id @default(autoincrement())
  accountId      Int
  account        KosAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statDate       DateTime
  itemCnt        Int      @default(0)
  crazyItemCnt   Int      @default(0)
  exposureSum    Int      @default(0)
  viewSum        Int      @default(0)
  diggSum        Int      @default(0)
  interactionSum Int      @default(0)
  followCountSum Int      @default(0)
  pmLeads        Int      @default(0)
  toolClickCnt   Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([accountId, statDate])
  @@index([statDate])
  @@index([accountId, statDate])
}

model KoxTask {
  id              Int      @id @default(autoincrement())
  taskTitle       String
  platform        String   @default("xhs")
  taskAccountType String   @default("KOS")
  startTime       DateTime
  endTime         DateTime
  status          String   @default("ongoing")
  createdById     Int
  createdBy       User     @relation("KoxTaskCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authors         KoxTaskAuthor[]

  @@index([status])
  @@index([platform])
}

model KoxTaskAuthor {
  id             Int        @id @default(autoincrement())
  taskId         Int
  task           KoxTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  accountId      Int
  account        KosAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  validItemCount Int        @default(0)
  violationCount Int        @default(0)
  viewCount      Int        @default(0)
  displayCount   Int        @default(0)
  diggCount      Int        @default(0)
  interaction    Int        @default(0)
  ces            Int        @default(0)
  finished       Boolean    @default(false)

  @@index([taskId])
  @@index([accountId])
}

model KoxDailyStat {
  id                 Int      @id @default(autoincrement())
  statDate           DateTime
  platform           String   @default("all")
  authorNum          Int      @default(0)
  itemCnt            Int      @default(0)
  crazyItemCnt       Int      @default(0)
  toolItemCntSum     Int      @default(0)
  followCountSum     Int      @default(0)
  exposureSum        Int      @default(0)
  viewSum            Int      @default(0)
  interactionSum     Int      @default(0)
  totalPmInquiries   Int      @default(0)
  totalPmOpenings    Int      @default(0)
  totalPmLeads       Int      @default(0)
  toolClickCnt       Int      @default(0)
  formLeads          Int      @default(0)
  adCost             Decimal  @default(0) @db.Decimal(14, 2)
  adViewSum          Int      @default(0)
  adConversions      Int      @default(0)
  liveAccountNum     Int      @default(0)
  liveCount          Int      @default(0)
  liveValidDuration  Int      @default(0)
  liveExposureUv     Int      @default(0)
  liveWatchUv        Int      @default(0)
  liveToolClickCnt   Int      @default(0)
  liveTotalLeads     Int      @default(0)
  liveFormLeads      Int      @default(0)
  liveCost           Decimal  @default(0) @db.Decimal(14, 2)
  brandId            Int      @default(1)

  @@unique([statDate, platform, brandId])
  @@index([statDate])
}

model KoxDealerSales {
  id         Int     @id @default(autoincrement())
  month      String
  dealerName String
  modelName  String?
  totalSales Int     @default(0)
  leadsCount Int     @default(0)
  brandId    Int     @default(1)

  @@index([month])
}

model KoxCampaignDailyStat {
  id              Int      @id @default(autoincrement())
  statDate        DateTime
  virtualSellerId String
  brandUserId     String?
  brandUserName   String?
  advertiserId    String?
  accountKind     String   @default("brand")
  agentName       String?
  fee             Decimal  @default(0) @db.Decimal(14, 2)
  impression      Int      @default(0)
  click           Int      @default(0)
  likeCnt         Int      @default(0)
  commentCnt      Int      @default(0)
  collectCnt      Int      @default(0)
  shareCnt        Int      @default(0)
  interaction     Int      @default(0)
  msgLeadsNum     Int      @default(0)
  msgChatUserCnt  Int      @default(0)
  messageConsult  Int      @default(0)
  leads           Int      @default(0)
  brandId         Int      @default(2)
  rawJson         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([statDate, virtualSellerId])
  @@index([statDate, brandId])
  @@index([brandUserId])
}

model SparkAccount {
  id              Int      @id @default(autoincrement())
  virtualSellerId String   @unique
  accountCode     String?
  accountKind     String   @default("brand")
  name            String
  brandUserId     String?
  agentName       String?
  advertiserId    String?
  lastConsumeDate String?
  active          Boolean  @default(true)
  scope           String   @default("dealer")
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  brandId         Int      @default(2)

  @@index([brandId, active])
  @@index([scope])
}

model SparkSyncLog {
  id              Int      @id @default(autoincrement())
  syncType        String
  statDate        String?
  status          String   @default("success")
  fetched         Int      @default(0)
  upserted        Int      @default(0)
  accountsAdded   Int      @default(0)
  accountsRemoved Int      @default(0)
  message         String?
  brandId         Int      @default(2)
  createdAt       DateTime @default(now())

  @@index([syncType, createdAt])
  @@index([brandId, syncType, statDate])
}

// 星火多组织配置：每个工作区(brand)一个 MCC 组织（orgCode + 独立 cookie）
// 首次启动时若无记录且 .env 有 SPARK_COOKIE，则自动引导生成 brand 2 的记录（向后兼容旧部署）
model SparkOrgConfig {
  id         Int       @id @default(autoincrement())
  brandId    Int       @unique
  orgCode    String
  email      String?
  cookie     String    @default("")
  active     Boolean   @default(true)
  lastSyncAt DateTime?
  remark     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model KoxCampaignProject {
  id            Int       @id @default(autoincrement())
  name          String
  startDate     DateTime
  endDate       DateTime
  budget        Decimal?  @db.Decimal(14, 2)
  remark        String?
  importedStats Json?
  brandId       Int       @default(2)
  createdById   Int
  createdBy     User      @relation("CampaignProjectCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      KoxCampaignProjectAccount[]

  @@index([brandId])
}

model KoxCampaignProjectAccount {
  id              Int    @id @default(autoincrement())
  projectId       Int
  project         KoxCampaignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualSellerId String

  @@unique([projectId, virtualSellerId])
  @@index([virtualSellerId])
}

model InsightContent {
  id          Int       @id @default(autoincrement())
  platform    String    @default("douyin")
  contentType String    @default("note")
  title       String
  authorName  String
  authorType  String    @default("KOC")
  publishAt   DateTime
  views       Int       @default(0)
  likes       Int       @default(0)
  comments    Int       @default(0)
  shares      Int       @default(0)
  collects    Int       @default(0)
  sentiment   String    @default("neutral")
  irrelevant  Boolean   @default(false)
  brandId     Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([brandId])
  @@index([platform])
  @@index([sentiment])
  @@index([publishAt])
}

model InsightDailyStat {
  id          Int      @id @default(autoincrement())
  statDate    DateTime
  platform    String   @default("all")
  contentCnt  Int      @default(0)
  mentionCnt  Int      @default(0)
  viewSum     Int      @default(0)
  likeSum     Int      @default(0)
  commentSum  Int      @default(0)
  shareSum    Int      @default(0)
  negativeCnt Int      @default(0)
  brandId     Int      @default(1)

  @@unique([statDate, platform, brandId])
  @@index([statDate])
}

model InsightReport {
  id         Int      @id @default(autoincrement())
  name       String
  period     String
  access     String   @default("public")
  fileSize   Int      @default(0)
  brandId    Int      @default(1)
  createdById Int
  createdAt  DateTime @default(now())

  @@index([brandId])
}

model LaiguLead {
  id                 Int       @id @default(autoincrement())
  brandId            Int       @default(5)
  sessionId          String    @unique
  clientId           String?
  clientName         String?
  phone              String?
  isResource         Boolean   @default(false)
  source             String?
  subSource          String?
  chatEntry          String?
  ipLocation         String?
  clientAttrs        Json?
  adInfo             Json?
  messageCount       Int       @default(0)
  clientMessageCount Int       @default(0)
  firstMessageAt     DateTime?
  lastMessageAt      DateTime?
  lastClientContent  String?
  sessionCreatedAt   DateTime?
  sessionEndedAt     DateTime?
  rawJson            Json
  fetchedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@index([brandId])
  @@index([brandId, sessionEndedAt])
  @@index([phone])
}
