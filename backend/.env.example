DATABASE_URL="postgresql://saas:saas@localhost:5432/saas?schema=public"
JWT_SECRET="change-me"
PORT=3000

# 专业号平台定时同步（分钟，<=0 禁用；20 小时内已同步则跳过）
PRO_SYNC_INTERVAL_MINUTES=60

# 来鼓后台账密（token 过期时自动重登用；不配置则需人工推送 token）
LAIGU_LOGIN_USER=""
LAIGU_LOGIN_PASSWORD=""

# ── 内容工厂Pro AIGC（不配 LLM_API_KEY 时 AI 生成自动降级为内置模板）──
# LLM：OpenAI 兼容协议（智谱/DeepSeek/通义/Kimi 通用），仅换下面三项即可切换
# 智谱示例（glm-4-flash 免费）：https://open.bigmodel.cn 注册 → 控制台 → API 密钥
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com / LLM_MODEL=deepseek-chat

# 创客贴开放平台（配置后图文配图/封面编辑器出现「创客贴模板」入口，导出图自动转存素材库）
CHUANGKIT_APP_KEY=
CHUANGKIT_EDITOR_URL=

# 品牌初始算力池（未手动建池时自动初始化用；1 篇图文 = 1 算力）
BRAND_QUOTA_DEFAULT=2000
